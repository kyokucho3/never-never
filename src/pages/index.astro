---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const tankaList = await getCollection("tanka");
const tankaData = tankaList.map((t) => ({ id: t.id, body: t.data.body }));
---

<Layout title="never-never">
    <div class="container">
        <div class="home">
            <h1>never-never</h1>
            <p class="description">
                短歌と雑記をおいていく場所。<br />
                ほそぼそ、もそもそ。
            </p>
            <div class="home-links">
                <a href="/tanka">短歌</a>
                <a href="/blog">雑記</a>
            </div>
            <div class="home-tanka">
                <a id="home-tanka-link" href="#" class="home-tanka-body"></a>
            </div>
        </div>
    </div>
</Layout>

<script define:vars={{ tankaData }} is:inline>
    const tanka = tankaData[Math.floor(Math.random() * tankaData.length)];
    const link = document.getElementById("home-tanka-link");
    link.href = `/tanka/${tanka.id}`;
    link.textContent = tanka.body;
</script>
