---
interface Props {
    lastPage: number;
    basePath: string;
}
const { lastPage, basePath } = Astro.props;
---

<div class="pagination">
    {
        Array.from({ length: lastPage }, (_, i) => (
            <a href={i === 0 ? basePath : `${basePath}/${i + 1}`}>{i + 1}</a>
        ))
    }
</div>
